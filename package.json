{
  "name": "transparent-compact",
  "version": "0.8.0",
  "private": false,
  "description": "Deterministic, transparent-preserving compaction for Pi, with session-backed subagent context recovery.",
  "license": "MIT",
  "homepage": "https://github.com/felixwoolford/transparent-compact-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixwoolford/transparent-compact-pi.git"
  },
  "bugs": {
    "url": "https://github.com/felixwoolford/transparent-compact-pi/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context-recovery"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "skills/context-retrieval/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "pi": {
    "extensions": ["./extensions/transparent-compact.ts"],
    "skills": ["./skills/context-retrieval"]
  },
  "scripts": {
    "test": "node scripts/test-all.cjs",
    "test:integration": "node test.cjs",
    "test:cap": "node test.cjs cap",
    "test:caphang": "node test.cjs caphang",
    "test:capspans": "node test.cjs capspans",
    "test:package": "node scripts/test-package.cjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3"
  }
}
