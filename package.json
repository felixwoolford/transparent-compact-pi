{
  "name": "@foliox/transparent-compact-pi",
  "version": "0.8.5",
  "description": "Deterministic, verbatim-preserving compaction for Pi, with session-backed subagent context recovery.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context-recovery"
  ],
  "homepage": "https://github.com/felixwoolford/transparent-compact-pi#readme",
  "bugs": {
    "url": "https://github.com/felixwoolford/transparent-compact-pi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixwoolford/transparent-compact-pi.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "files": [
    "extensions/",
    "skills/context-retrieval/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "test": "node scripts/test-all.cjs",
    "test:integration": "node test.cjs",
    "test:cap": "node test.cjs cap",
    "test:caphang": "node test.cjs caphang",
    "test:capspans": "node test.cjs capspans",
    "test:package": "node scripts/test-package.cjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/context-retrieval"
    ]
  }
}
